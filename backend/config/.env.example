PIPELINE_ENVIRONMENT=development
PIPELINE_ALLOWED_ORIGINS=http://localhost:3000
PIPELINE_QUEUE_BACKEND=memory
PIPELINE_OBJECT_STORE_BACKEND=filesystem
PIPELINE_SEARCH_BACKEND=sqlite
PIPELINE_DATABASE_URL=sqlite:///./data/pipeline.db

PIPELINE_AWS_REGION=
PIPELINE_SQS_INGEST_QUEUE_URL=
PIPELINE_SQS_EXTRACT_QUEUE_URL=
