# Copy this file to .env and fill in real values. Never commit .env itself.

# Google Gemini free-tier API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Local path for the Chroma vector store
VECTOR_STORE_PATH=./data/vector_store

LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# Multilingual data pipeline (backend/modules/pipeline)
#
# Defaults below are the FREE MVP STACK: local filesystem, SQLite, in-process
# queue, self-hosted translation. They run on a laptop with no cloud account,
# which is what docs/ARCHITECTURE.md commits to. Production overrides these
# without any code change.
# ---------------------------------------------------------------------------

# --- Adapter selection ---
PIPELINE_QUEUE_BACKEND=memory              # memory | sqs | kafka
PIPELINE_OBJECT_STORE_BACKEND=filesystem   # filesystem | s3
PIPELINE_SEARCH_BACKEND=sqlite             # sqlite | opensearch
PIPELINE_DATABASE_URL=sqlite:///./data/pipeline.db

# --- Language detection (PDF 3.3) ---
PIPELINE_LANGUAGE_DETECTOR=fasttext
# Below this confidence a HUMAN confirms the language instead of the model
# guessing. Bad detection silently poisons translation. Tune from real data:
# an always-empty confirmation queue means this is too low to be doing anything.
PIPELINE_LANGUAGE_CONFIDENCE_THRESHOLD=0.90
PIPELINE_TARGET_LANGUAGE=sw

# --- Translation (PDF 3.4) ---
# nllb = self-hosted, free, no per-call cost — the default for this project.
# Use "passthrough" for local development with no model download at all.
PIPELINE_TRANSLATION_ENGINE=nllb
PIPELINE_TRANSLATION_MAX_CHUNK_CHARS=4000
PIPELINE_TRANSLATION_BATCH_SIZE=16
# Only needed when TRANSLATION_ENGINE is a cloud provider:
# PIPELINE_TRANSLATION_API_KEY=

# --- Retries & backoff ---
PIPELINE_MAX_ATTEMPTS=5
PIPELINE_BACKOFF_BASE_SECONDS=2.0
PIPELINE_BACKOFF_CAP_SECONDS=600.0

# --- Ingestion limits ---
PIPELINE_FETCH_TIMEOUT_SECONDS=30
PIPELINE_FETCH_MAX_BYTES=104857600         # 100 MB
PIPELINE_RESPECT_ROBOTS_TXT=true           # do not set this to false
PIPELINE_USER_AGENT=MamaCareAI-DataPipeline/0.1 (+contact: nebotechtz@gmail.com)

# --- Extraction quality gate ---
PIPELINE_MIN_EXTRACTED_CHARS=200

# --- Storage paths (filesystem backend) ---
PIPELINE_OBJECT_STORE_PATH=./data/02_raw

# --- Compliance gate before publication (PDF section 4) ---
# strict=true means an UNKNOWN licence blocks publication. Keep it true.
PIPELINE_COMPLIANCE_STRICT=true
PIPELINE_ALLOWED_LICENSES=public-domain,CC0,CC-BY-4.0,permission-granted

# --- Observability ---
PIPELINE_METRICS_ENABLED=true
PIPELINE_LOG_LEVEL=INFO
