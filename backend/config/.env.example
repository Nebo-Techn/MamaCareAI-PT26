PIPELINE_SQS_TRANSLATE_QUEUE_URL=
PIPELINE_SQS_STORE_QUEUE_URL=
PIPELINE_SQS_REVIEW_QUEUE_URL=
PIPELINE_SQS_PUBLISH_QUEUE_URL=
PIPELINE_SQS_DEAD_LETTER_URL=

PIPELINE_S3_BUCKET=
PIPELINE_S3_ENDPOINT_URL=
PIPELINE_S3_PREFIX=
PIPELINE_OPENSEARCH_HOSTS=
PIPELINE_OPENSEARCH_INDEX=mamacare-resources
PIPELINE_OPENSEARCH_USERNAME=
PIPELINE_OPENSEARCH_PASSWORD=

PIPELINE_LANGUAGE_DETECTOR=fasttext
PIPELINE_FASTTEXT_MODEL_PATH=./models/lid.176.bin
PIPELINE_LANGUAGE_CONFIDENCE_THRESHOLD=0.90
PIPELINE_TARGET_LANGUAGE=sw
PIPELINE_TRANSLATE_SOURCE_LANGUAGES=en
PIPELINE_DIRECT_REVIEW_LANGUAGES=sw

PIPELINE_TRANSLATION_ENGINE=nllb
PIPELINE_TRANSLATION_API_KEY=
PIPELINE_TRANSLATION_MAX_CHUNK_CHARS=4000
