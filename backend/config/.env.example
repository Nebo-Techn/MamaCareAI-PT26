PIPELINE_BACKOFF_CAP_SECONDS=600.0
PIPELINE_FETCH_TIMEOUT_SECONDS=30
PIPELINE_FETCH_MAX_BYTES=104857600
PIPELINE_RESPECT_ROBOTS_TXT=true
