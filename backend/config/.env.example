# Copy this file to .env and fill in real values. Never commit .env itself.

# Google Gemini free-tier API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Local path for the Chroma vector store
VECTOR_STORE_PATH=./data/vector_store

LOG_LEVEL=INFO
